# ============================================================
# Legal AI Vietnam - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- LLM API Keys (at least one required) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- LLM Configuration ---
# Primary model for analysis (Claude recommended)
LLM_PRIMARY_MODEL=claude-3-5-sonnet-20241022
# Fallback model
LLM_FALLBACK_MODEL=gpt-4o-mini
# Max tokens per request
LLM_MAX_TOKENS=4096
# Temperature (0.0 = deterministic, good for legal analysis)
LLM_TEMPERATURE=0.1

# --- Database ---
# SQLite database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///./data/db/legal_ai.db
# Path for database file
DB_PATH=./data/db/legal_ai.db

# --- Embedding ---
# Model for text embeddings (fastembed ONNX - no PyTorch needed)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768
# Cache directory for downloaded models
FASTEMBED_CACHE_DIR=./data/models/fastembed

# --- Application ---
APP_NAME=Legal AI Vietnam
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
# Secret key for sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key

# --- Data Paths ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_DIR=./data/sample
MODELS_DIR=./data/models

# --- API Server ---
API_HOST=127.0.0.1
API_PORT=8000
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Data Sources (for scraping - OPTIONAL) ---
# Rate limiting: seconds between requests
CRAWLER_DELAY_SECONDS=2.0
# Maximum concurrent requests
CRAWLER_MAX_CONCURRENT=3
# User agent for crawlers
CRAWLER_USER_AGENT=LegalAIResearch/0.1 (academic research; contact: research@example.com)

# --- HuggingFace (for dataset loading) ---
# Optional: for private datasets or higher rate limits
HUGGINGFACE_TOKEN=

# --- Research ---
# Random seed for reproducibility
RANDOM_SEED=42
# Experiment tracking
EXPERIMENT_NAME=legal-ai-vietnam-mvp
